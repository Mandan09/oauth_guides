# Required
GEMINI_API_KEY=

# Postgres for deployment (Neon connection string). Leave unset locally to use SQLite.
DATABASE_URL=

# Optional fallbacks (free tiers)
OPENROUTER_API_KEY=
GROQ_API_KEY=
TAVILY_API_KEY=

# Protects POST /api/runs with force=true (regenerate)
ADMIN_TOKEN=

# Optional overrides
# RESEARCH_MODEL=gemini-flash-latest
# WRITER_MODEL=gemini-pro-latest
# SEARCH_MODEL=gemini-flash-latest
# FALLBACK_MODELS=openrouter/nvidia/nemotron-3-ultra-550b-a55b:free,groq/openai/gpt-oss-120b
# RUNS_PER_IP_PER_HOUR=5
# RUNS_PER_DAY=50
